<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Soccer Scoreboard</title>

<style>
* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    font-family: Arial, Helvetica, sans-serif;
    overflow: hidden;
}

#scoreboard {
    position: relative;
    width: 900px;
    height: 120px;
    min-width: 500px;
    max-width: 100vw;
    margin: 20px auto;
    color: white;
    user-select: none;
}

.bar {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    background: rgba(10, 10, 10, 0.94);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,.35);
}

/* Teams */

.team {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;
    flex: 1;
}

.team.left {
    justify-content: flex-end;
}

.team.right {
    justify-content: flex-start;
}

.logo {
    width: 65px;
    height: 65px;
    object-fit: contain;
}

.teamName {
    font-size: 25px;
    font-weight: 700;
    white-space: nowrap;
}

/* Scores */

.score {
    font-size: 42px;
    font-weight: 900;
    min-width: 55px;
    text-align: center;
}

/* Center */

.center {
    width: 190px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: rgba(255,255,255,.08);
}

.timer {
    font-size: 28px;
    font-weight: 900;
    letter-spacing: 1px;
}

.half {
    font-size: 13px;
    opacity: .8;
    margin-top: 3px;
}

/* Cards */

.cards {
    display: flex;
    gap: 5px;
    align-items: center;
}

.card {
    width: 15px;
    height: 21px;
    border-radius: 2px;
}

.yellow {
    background: #ffd900;
}

.red {
    background: #e00000;
}

/* Controls */

#controls {
    position: fixed;
    left: 15px;
    top: 15px;
    width: 320px;
    max-height: calc(100vh - 30px);
    overflow-y: auto;
    background: rgba(20,20,20,.97);
    color: white;
    padding: 18px;
    border-radius: 12px;
    z-index: 1000;
    box-shadow: 0 8px 30px rgba(0,0,0,.5);
}

#controls h2 {
    margin: 0 0 15px;
    font-size: 20px;
}

.section {
    margin-bottom: 15px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255,255,255,.15);
}

label {
    display: block;
    font-size: 12px;
    margin-bottom: 5px;
    opacity: .85;
}

input[type="text"],
input[type="number"],
input[type="url"] {
    width: 100%;
    padding: 9px;
    margin-bottom: 8px;
    border: 0;
    border-radius: 6px;
    background: #333;
    color: white;
}

button {
    border: 0;
    border-radius: 6px;
    padding: 9px 12px;
    margin: 3px 2px;
    cursor: pointer;
    font-weight: 700;
}

button:hover {
    opacity: .85;
}

.primary {
    background: #1683ff;
    color: white;
}

.green {
    background: #19a463;
    color: white;
}

.redBtn {
    background: #d92727;
    color: white;
}

.gray {
    background: #555;
    color: white;
}

.row {
    display: flex;
    gap: 5px;
    align-items: center;
}

.row input {
    flex: 1;
}

.small {
    font-size: 11px;
    opacity: .7;
}

#hideControls {
    position: fixed;
    right: 15px;
    top: 15px;
    z-index: 2000;
    background: #1683ff;
    color: white;
}

/* Responsive */

@media(max-width: 700px) {
    #scoreboard {
        transform-origin: top center;
    }

    .teamName {
        font-size: 17px;
    }

    .logo {
        width: 45px;
        height: 45px;
    }

    .score {
        font-size: 32px;
    }

    .center {
        width: 130px;
    }

    .timer {
        font-size: 22px;
    }
}
</style>
</head>

<body>

<div id="scoreboard">

    <div class="bar">

        <div class="team left">

            <div>
                <div class="teamName" id="team1Display">HOME</div>

                <div class="cards">
                    <span id="team1Yellow"></span>
                    <span id="team1Red"></span>
                </div>
            </div>

            <img id="logo1Display"
                 class="logo"
                 src=""
                 alt="">

            <div class="score" id="score1Display">0</div>

        </div>


        <div class="center">

            <div class="timer" id="timerDisplay">00:00</div>

            <div class="half" id="halfDisplay">
                1ST HALF
            </div>

        </div>


        <div class="team right">

            <div class="score" id="score2Display">0</div>

            <img id="logo2Display"
                 class="logo"
                 src=""
                 alt="">

            <div>
                <div class="teamName" id="team2Display">AWAY</div>

                <div class="cards">
                    <span id="team2Yellow"></span>
                    <span id="team2Red"></span>
                </div>
            </div>

        </div>

    </div>

</div>


<button id="hideControls"
        onclick="toggleControls()">
    Hide Controls
</button>


<div id="controls">

<h2>⚽ Soccer Scoreboard</h2>


<div class="section">

<label>Home Team</label>

<input id="team1Input"
       type="text"
       value="HOME"
       oninput="updateTeams()">

<label>Home Logo URL</label>

<input id="logo1Input"
       type="url"
       placeholder="Paste image URL"
       oninput="updateLogos()">

<div class="row">

<button class="green"
        onclick="changeScore(1,1)">
+ Goal
</button>

<button class="redBtn"
        onclick="changeScore(1,-1)">
− Goal
</button>

</div>

<div class="row">

<button class="gray"
        onclick="changeYellow(1,1)">
+ Yellow
</button>

<button class="gray"
        onclick="changeYellow(1,-1)">
− Yellow
</button>

</div>

<div class="row">

<button class="redBtn"
        onclick="changeRed(1,1)">
+ Red
</button>

<button class="gray"
        onclick="changeRed(1,-1)">
− Red
</button>

</div>

</div>


<div class="section">

<label>Away Team</label>

<input id="team2Input"
       type="text"
       value="AWAY"
       oninput="updateTeams()">

<label>Away Logo URL</label>

<input id="logo2Input"
       type="url"
       placeholder="Paste image URL"
       oninput="updateLogos()">

<div class="row">

<button class="green"
        onclick="changeScore(2,1)">
+ Goal
</button>

<button class="redBtn"
        onclick="changeScore(2,-1)">
− Goal
</button>

</div>

<div class="row">

<button class="gray"
        onclick="changeYellow(2,1)">
+ Yellow
</button>

<button class="gray"
        onclick="changeYellow(2,-1)">
− Yellow
</button>

</div>

<div class="row">

<button class="redBtn"
        onclick="changeRed(2,1)">
+ Red
</button>

<button class="gray"
        onclick="changeRed(2,-1)">
− Red
</button>

</div>

</div>


<div class="section">

<label>Timer</label>

<button class="green"
        onclick="startTimer()">
▶ Start
</button>

<button class="gray"
        onclick="pauseTimer()">
Ⅱ Pause
</button>

<button class="redBtn"
        onclick="resetTimer()">
↻ Reset
</button>

<br>

<button class="primary"
        onclick="setHalf('1ST HALF')">
1st Half
</button>

<button class="primary"
        onclick="setHalf('2ND HALF')">
2nd Half
</button>

<button class="primary"
        onclick="setHalf('HALF TIME')">
Half Time
</button>

<button class="primary"
        onclick="setHalf('FULL TIME')">
Full Time
</button>

</div>


<div class="section">

<h3>📐 Scoreboard Size</h3>

<label>Width (px)</label>

<input id="widthInput"
       type="number"
       value="900"
       min="400"
       max="2000"
       onchange="resizeBoard()">

<label>Height (px)</label>

<input id="heightInput"
       type="number"
       value="120"
       min="70"
       max="500"
       onchange="resizeBoard()">

<button class="primary"
        onclick="resizeBoard()">
Apply Size
</button>

</div>


<div class="section">

<button class="redBtn"
        onclick="resetEverything()">
Reset Match
</button>

</div>


<div class="small">
Tip: Set everything here, then press "Hide Controls" before using the scoreboard in Streamlabs.
</div>

</div>


<script>

let score1 = 0;
let score2 = 0;

let yellow1 = 0;
let yellow2 = 0;

let red1 = 0;
let red2 = 0;

let seconds = 0;
let timerRunning = false;
let timerInterval = null;


/* TEAM NAMES */

function updateTeams() {

    document.getElementById("team1Display").textContent =
        document.getElementById("team1Input").value || "HOME";

    document.getElementById("team2Display").textContent =
        document.getElementById("team2Input").value || "AWAY";
}


/* LOGOS */

function updateLogos() {

    const logo1 =
        document.getElementById("logo1Input").value;

    const logo2 =
        document.getElementById("logo2Input").value;

    document.getElementById("logo1Display").src = logo1;

    document.getElementById("logo2Display").src = logo2;
}


/* SCORE */

function changeScore(team, amount) {

    if(team === 1) {

        score1 = Math.max(0, score1 + amount);

        document.getElementById("score1Display").textContent =
            score1;

    } else {

        score2 = Math.max(0, score2 + amount);

        document.getElementById("score2Display").textContent =
            score2;
    }
}


/* YELLOW CARDS */

function changeYellow(team, amount) {

    if(team === 1) {

        yellow1 = Math.max(0, yellow1 + amount);

        document.getElementById("team1Yellow").innerHTML =
            "🟨".repeat(yellow1);

    } else {

        yellow2 = Math.max(0, yellow2 + amount);

        document.getElementById("team2Yellow").innerHTML =
            "🟨".repeat(yellow2);
    }
}


/* RED CARDS */

function changeRed(team, amount) {

    if(team === 1) {

        red1 = Math.max(0, red1 + amount);

        document.getElementById("team1Red").innerHTML =
            " 🟥".repeat(red1);

    } else {

        red2 = Math.max(0, red2 + amount);

        document.getElementById("team2Red").innerHTML =
            " 🟥".repeat(red2);
    }
}


/* TIMER */

function updateTimerDisplay() {

    const minutes =
        Math.floor(seconds / 60)
        .toString()
        .padStart(2, "0");

    const secs =
        (seconds % 60)
        .toString()
        .padStart(2, "0");

    document.getElementById("timerDisplay").textContent =
        minutes + ":" + secs;
}


function startTimer() {

    if(timerRunning) return;

    timerRunning = true;

    timerInterval = setInterval(() => {

        seconds++;

        updateTimerDisplay();

    }, 1000);
}


function pauseTimer() {

    timerRunning = false;

    clearInterval(timerInterval);
}


function resetTimer() {

    pauseTimer();

    seconds = 0;

    updateTimerDisplay();
}


/* HALF */

function setHalf(text) {

    document.getElementById("halfDisplay").textContent =
        text;
}


/* RESIZE */

function resizeBoard() {

    const width =
        parseInt(document.getElementById("widthInput").value);

    const height =
        parseInt(document.getElementById("heightInput").value);

    if(width >= 400 && width <= 2000) {

        document.getElementById("scoreboard").style.width =
            width + "px";
    }

    if(height >= 70 && height <= 500) {

        document.getElementById("scoreboard").style.height =
            height + "px";
    }
}


/* HIDE CONTROLS */

function toggleControls() {

    const controls =
        document.getElementById("controls");

    const button =
        document.getElementById("hideControls");

    if(controls.style.display === "none") {

        controls.style.display = "block";

        button.textContent = "Hide Controls";

    } else {

        controls.style.display = "none";

        button.textContent = "Show Controls";
    }
}


/* RESET */

function resetEverything() {

    score1 = 0;
    score2 = 0;

    yellow1 = 0;
    yellow2 = 0;

    red1 = 0;
    red2 = 0;

    resetTimer();

    document.getElementById("score1Display").textContent = "0";
    document.getElementById("score2Display").textContent = "0";

    document.getElementById("team1Yellow").innerHTML = "";
    document.getElementById("team2Yellow").innerHTML = "";

    document.getElementById("team1Red").innerHTML = "";
    document.getElementById("team2Red").innerHTML = "";

    setHalf("1ST HALF");
}


/* INITIALIZE */

updateTeams();
updateLogos();
updateTimerDisplay();

</script>

</body>
</html>
